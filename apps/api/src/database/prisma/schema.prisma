generator client {
  provider = "prisma-client"
  output   = "../../../../../libs/shared/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  RETRYING
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model Notification {
  id String @id @default(uuid())

  notificationId String              @unique
  userId         String
  channel        NotificationChannel
  status         NotificationStatus  @default(QUEUED)

  subject String?
  title   String?
  body    String

  template     String?
  templateData Json?

  provider          String?
  providerMessageId String?

  idempotencyKey String @unique

  attempts Int @default(0)

  queuedAt      DateTime  @default(now())
  processingAt  DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade)

  deliveryKey String @unique

  provider String
  channel  NotificationChannel

  status NotificationDeliveryStatus @default(PENDING)

  attempts Int @default(0)

  providerMessageId String?

  lastAttemptAt DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notificationId])
  @@index([provider, status])
  @@index([status, lastAttemptAt])
}

model OutboxEvent {
  id String @id @default(uuid())

  eventType     String
  aggregateType String
  aggregateId   String

  dedupeKey String @unique

  payload Json

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  availableAt DateTime @default(now())

  lockedAt DateTime?
  lockedBy String?

  publishedAt DateTime?

  deadLetteredAt DateTime?
  recoveredAt    DateTime?

  recoveryCount Int @default(0)

  lastAttemptAt DateTime?

  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([lockedAt])
  @@index([deadLetteredAt])
}
