{
  "name": "@gurusthalam/workspace",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "prepare": "husky",
    "start:web": "nx serve @org/web",
    "start:admin": "nx serve admin-web",
    "start:api": "nx serve api",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "projects": "nx show projects",
    "report": "nx report"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md,mdx,css,scss}": [
      "prettier --write"
    ]
  },
