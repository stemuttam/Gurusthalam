generator client {
  provider = "prisma-client"
  output   = "../../../../../libs/shared/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// Course Domain
// =============================================================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseType {
  SELF_PACED
  LIVE
  BLENDED
}

enum CourseVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CourseVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseOwnershipRole {
  OWNER
  AUTHOR
  CO_AUTHOR
  EDITOR
  REVIEWER
  PUBLISHER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EnrollmentSource {
  DIRECT
  COHORT
  ORGANIZATION
  SUBSCRIPTION
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum LearningSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SectionProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EntitlementSource {
  DIRECT
  COHORT
  ORGANIZATION
  SUBSCRIPTION
}

model Course {
  id String @id @default(uuid())

  title       String
  description String?

  level CourseLevel
  type  CourseType

  visibility CourseVisibility @default(PRIVATE)
  status     CourseStatus     @default(DRAFT)

  instructorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions             CourseVersion[]
  ownershipAssignments CourseOwnershipAssignment[]
  enrollments          Enrollment[]

  @@index([instructorId])
  @@index([status])
  @@index([visibility])
  @@index([status, visibility])
  @@index([instructorId, status])
}

model CourseOwnershipAssignment {
  courseId    String
  principalId String
  role        CourseOwnershipRole
  position    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([courseId, principalId, role])
  @@unique([courseId, position])
  @@index([courseId, role])
  @@index([principalId, role, courseId])
}

model CourseVersion {
  id String @id @default(uuid())

  courseId String
  version  Int

  status CourseVersionStatus @default(DRAFT)

  title       String
  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  auditEntries             CourseVersionAudit[]
  enrollments              Enrollment[]
  structureSections        CourseStructureSection[]
  courseProgressReadModels CourseProgressReadModel[]

  lineageAsSource CourseVersionLineage[] @relation("CourseVersionLineageSource")
  lineageAsTarget CourseVersionLineage[] @relation("CourseVersionLineageTarget")

  @@unique([courseId, version])
  @@index([courseId, status])
  @@index([status, publishedAt])
  @@index([courseId, status, version])
}

model CourseVersionAudit {
  id String @id @default(uuid())

  courseId        String
  courseVersionId String
  version         Int

  eventType String

  occurredAt DateTime

  actorType String
  actorId   String

  reason   String?
  metadata Json

  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([courseVersionId, occurredAt, id])
  @@index([courseId, occurredAt, id])
  @@index([courseId, version])
  @@index([eventType, occurredAt])
  @@index([actorType, actorId])
}

model CourseVersionLineage {
  id String @id @default(uuid())

  courseId String

  sourceVersionId String
  sourceVersion   Int

  targetVersionId String
  targetVersion   Int

  relation String
  reason   String

  createdAt DateTime @default(now())

  sourceVersionRecord CourseVersion @relation("CourseVersionLineageSource", fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetVersionRecord CourseVersion @relation("CourseVersionLineageTarget", fields: [targetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceVersionId, targetVersionId, relation])
  @@index([courseId, sourceVersion, targetVersion])
  @@index([courseId, targetVersion])
  @@index([sourceVersionId])
  @@index([targetVersionId])
}

model Enrollment {
  id String @id @default(uuid())

  learnerId String

  courseId        String
  courseVersionId String

  status EnrollmentStatus @default(ACTIVE)
  source EnrollmentSource

  startsAt  DateTime
  expiresAt DateTime?

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  courseProgressReadModelsByVersion CourseProgressReadModel[] @relation("CourseProgressReadModelEnrollmentVersion")

  entitlements            Entitlement[]
  learningSessions        LearningSession[]
  progress                Progress?
  lessonProgress          LessonProgress[]
  sectionProgress         SectionProgress[]
  courseProgressReadModel CourseProgressReadModel?

  @@unique([id, courseVersionId])
  @@index([learnerId, status, createdAt])
  @@index([courseId, status, createdAt])
  @@index([courseVersionId, status])
  @@index([status, expiresAt])
}

model Entitlement {
  id String @id @default(uuid())

  enrollmentId String

  status EntitlementStatus @default(ACTIVE)
  source EntitlementSource

  startsAt  DateTime
  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enrollmentId, status, createdAt])
  @@index([status, expiresAt])
  @@index([source, status])
}

model LearningSession {
  id String @id @default(uuid())

  enrollmentId String

  status LearningSessionStatus @default(ACTIVE)

  startedAt DateTime
  pausedAt  DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enrollmentId, startedAt])
  @@index([status, endedAt])
}

model Progress {
  id String @id @default(uuid())

  enrollmentId String

  status ProgressStatus @default(NOT_STARTED)

  percentage Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId])
}

model LessonProgress {
  id String @id @default(uuid())

  enrollmentId   String
  learningUnitId String

  status LessonProgressStatus @default(NOT_STARTED)

  percentage Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, learningUnitId])
  @@index([enrollmentId, status])
  @@index([learningUnitId, status])
}

model SectionProgress {
  id String @id @default(uuid())

  enrollmentId String
  sectionId    String

  status SectionProgressStatus @default(NOT_STARTED)

  percentage Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, sectionId])
  @@index([enrollmentId, status])
  @@index([sectionId, status])
}

/// Durable history of validated learner activity occurrences.
///
/// This model intentionally has no foreign keys to learner, session,
/// lesson, section, or assessment records because the current activity
/// contract does not establish all of those persistence relationships.
///
/// `eventId` is the idempotency identity supplied by the event producer.
/// `payload` preserves the complete validated contract while the other
/// fields support indexed history queries.
model LearningActivityEvent {
  id String @id @default(uuid())

  eventId   String  @unique
  learnerId String
  tenantId  String?
  sessionId String?

  eventType  String
  entityType String
  entityId   String

  occurredAt DateTime

  context  Json
  metrics  Json?
  metadata Json?
  payload  Json

  receivedAt DateTime @default(now())

  @@index([learnerId, occurredAt, eventId])
  @@index([tenantId, learnerId, occurredAt])
  @@index([eventType, occurredAt, eventId])
  @@index([entityType, entityId, occurredAt, eventId])
  @@index([sessionId, occurredAt, eventId])
}

// =============================================================
// Course Read Models / Projections
// =============================================================

/**
 * CourseCatalogProjection
 * PostgreSQL persistence for the canonical CourseCatalog read model.
 * This is deliberately independent from the transactional Course table.
 * The projection is derived state and may be rebuilt from authoritative
 * Course/domain-event state.
 */
model CourseCatalogProjection {
  /**
   * Stable identity of the Course projection.
   * Deliberately not a foreign key to Course.
   * Projection persistence must remain independently rebuildable and
   * must not require the transactional Course row to exist.
   */
  courseId String @id

  title       String
  description String?

  level      CourseLevel
  type       CourseType
  visibility CourseVisibility
  status     CourseStatus

  instructorId String

  createdAt DateTime
  updatedAt DateTime

  /**
   * Independent read-model contract version.
   * This is intentionally independent from:
   * - Prisma schema versions;
   * - migration versions;
   * - Course domain-event versions.
   */
  projectionSchemaVersion Int

  @@index([status, visibility])
  @@index([instructorId, status])
  @@index([level])
  @@index([type])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdAt, courseId])
  @@index([updatedAt, courseId])
}

/**
 * CourseSearchProjection
 * PostgreSQL persistence for the CourseSearch read representation.
 * It intentionally duplicates the canonical catalog fields required by
 * search-oriented consumers so search reads do not need to hydrate the
 * Course aggregate or depend on the transactional repository.
 * Search-engine-specific concepts remain outside this persistence model.
 */
model CourseSearchProjection {
  /**
   * Stable Course identity shared with CourseCatalogProjection.
   */
  courseId String @id

  title       String
  description String?

  level      CourseLevel
  type       CourseType
  visibility CourseVisibility
  status     CourseStatus

  instructorId String

  createdAt DateTime
  updatedAt DateTime

  /**
   * Version of the source CourseCatalog projection contract.
   */
  projectionSchemaVersion Int

  /**
   * Deterministic lexical/search representation.
   * This does not imply a particular search engine or AI system.
   */
  searchText String

  /**
   * Independent CourseSearch projection contract version.
   */
  searchProjectionSchemaVersion Int

  @@index([status, visibility])
  @@index([instructorId, status])
  @@index([level])
  @@index([type])
  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdAt, courseId])
  @@index([updatedAt, courseId])
}

// =============================================================
// Notification Domain
// =============================================================

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  ACCEPTANCE_UNKNOWN
  SENT
  RETRYING
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTANCE_UNKNOWN
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

// =============================================================
// Notification Aggregation Domain
// =============================================================

enum NotificationAggregationStatus {
  OPEN
  FLUSHING
  FLUSHED
  FAILED
}

// =============================================================
// Notification Template Domain
// =============================================================

enum NotificationTemplateChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationTemplateStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum NotificationTemplateCategory {
  SYSTEM
  SECURITY
  AUTHENTICATION
  COURSE
  LEARNING
  PAYMENT
  SUBSCRIPTION
  CERTIFICATE
  CORPORATE
  MARKETING
  REMINDER
}

model NotificationTemplate {
  id String @id @default(uuid())

  templateId  String  @unique
  name        String
  description String?

  channel  NotificationTemplateChannel
  category NotificationTemplateCategory
  locale   String

  status         NotificationTemplateStatus @default(DRAFT)
  currentVersion Int                        @default(1)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions NotificationTemplateVersion[]

  @@index([channel, status])
  @@index([category, status])
  @@index([locale, status])
  @@index([createdBy, createdAt])
}

model NotificationTemplateVersion {
  id String @id @default(uuid())

  templateId String
  version    Int

  subject String?
  title   String?
  body    String

  variables Json

  status NotificationTemplateStatus @default(DRAFT)

  createdBy   String
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([status, publishedAt])
  @@index([createdBy, createdAt])
}

// =============================================================
// Existing Notification Domain
// =============================================================

model Notification {
  id String @id @default(uuid())

  notificationId String @unique
  userId         String

  channel NotificationChannel
  status  NotificationStatus  @default(QUEUED)

  subject String?
  title   String?
  body    String

  template         String?
  templateVersion  Int?
  templateLocale   String?
  templateData     Json?
  templateSnapshot Json?

  provider          String?
  providerMessageId String?

  idempotencyKey String @unique

  attempts           Int     @default(0)
  activeAttemptToken String?

  queuedAt      DateTime  @default(now())
  processingAt  DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([channel, status])
  @@index([template, templateVersion])
}

model NotificationDelivery {
  id String @id @default(uuid())

  notificationId String
  deliveryKey    String @unique

  provider                    String
  channel                     NotificationChannel
  providerSubmissionStartedAt DateTime?

  status NotificationDeliveryStatus @default(PENDING)

  attempts           Int     @default(0)
  activeAttemptToken String?

  providerMessageId String?

  lastAttemptAt DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([notificationId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status])
}

model OutboxEvent {
  id String @id @default(uuid())

  eventType     String
  aggregateType String
  aggregateId   String

  dedupeKey String @unique

  payload Json

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  availableAt DateTime @default(now())

  lockedAt DateTime?
  lockedBy String?

  publishedAt DateTime?

  deadLetteredAt DateTime?
  recoveredAt    DateTime?

  recoveryCount Int @default(0)

  lastAttemptAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([lockedAt])
  @@index([deadLetteredAt])
}

// =============================================================
// Notification Aggregation Domain
// =============================================================

model NotificationAggregation {
  id String @id @default(uuid())

  aggregationId String @unique

  /**
   * Canonical deterministic identity generated by the
   * aggregation domain policy.
   */
  groupKey String @unique

  userId         String
  channel        NotificationChannel
  category       String
  aggregationKey String
  locale         String

  status NotificationAggregationStatus @default(OPEN)

  windowStart DateTime
  windowEnd   DateTime

  itemCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NotificationAggregationItem[]

  @@index([userId, channel, status])
  @@index([status, windowEnd])
}

model NotificationAggregationItem {
  id String @id @default(uuid())

  aggregationId String

  sourceEventId String
  occurredAt    DateTime
  orderingKey   String

  createdAt DateTime @default(now())

  aggregation NotificationAggregation @relation(fields: [aggregationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /**
   * Database-level idempotency:
   * one source event can occur only once in an aggregation.
   */
  @@unique([aggregationId, sourceEventId])
  /**
   * Deterministic retrieval order.
   */
  @@index([aggregationId, orderingKey])
}

model CourseStructureSection {
  id              String   @id
  courseVersionId String
  title           String
  description     String?
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseVersion CourseVersion                 @relation(fields: [courseVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  learningUnits CourseStructureLearningUnit[]

  @@unique([courseVersionId, position])
  @@index([courseVersionId, id])
}

model CourseStructureLearningUnit {
  id          String   @id
  sectionId   String
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section               CourseStructureSection                @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItemReferences CourseStructureContentItemReference[]
  assessmentReferences  CourseStructureAssessmentReference[]

  @@unique([sectionId, position])
  @@index([sectionId, id])
}

model CourseStructureContentItemReference {
  id                  String @id
  learningUnitId      String
  contentItemTargetId String
  position            Int

  learningUnit CourseStructureLearningUnit @relation(fields: [learningUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([learningUnitId, position])
  @@index([contentItemTargetId])
}

model CourseStructureAssessmentReference {
  id                 String @id
  learningUnitId     String
  assessmentTargetId String
  position           Int

  learningUnit CourseStructureLearningUnit @relation(fields: [learningUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([learningUnitId, position])
  @@index([assessmentTargetId])
}

/// Derived, enrollment-scoped Course Progress projection.
/// This model is not the authoritative Progress lifecycle aggregate.
model CourseProgressReadModel {
  enrollmentId           String   @id
  courseVersionId        String
  totalLearningUnits     Int
  startedLearningUnits   Int
  completedLearningUnits Int
  percentage             Int
  hasLearningUnits       Boolean
  calculatedAt           DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  enrollmentVersion Enrollment @relation("CourseProgressReadModelEnrollmentVersion", fields: [enrollmentId, courseVersionId], references: [id, courseVersionId], onDelete: Cascade, onUpdate: Cascade)

  @@index([courseVersionId, calculatedAt])
  @@index([calculatedAt])
}

// -----------------------------------------------------------------------------
// Auth0 identity, internal principal, and tenant membership.
// These records are Gurusthalam-owned. Auth0 subject/organization claims are
// external identifiers and must never become learner IDs by inference.
// -----------------------------------------------------------------------------

enum AuthPrincipalStatus {
  ACTIVE
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum PrincipalTenantMembershipStatus {
  ACTIVE
  SUSPENDED
}

model AuthPrincipal {
  id        String              @id @default(uuid())
  status    AuthPrincipalStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  externalIdentities ExternalIdentity[]
  memberships        PrincipalTenantMembership[]

  @@index([status, createdAt])
}

model ExternalIdentity {
  id          String   @id @default(uuid())
  provider    String
  issuer      String
  subject     String
  principalId String
  createdAt   DateTime @default(now())

  principal AuthPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, issuer, subject])
  @@index([principalId])
}

model Tenant {
  id                  String       @id @default(uuid())
  slug                String       @unique
  name                String
  auth0OrganizationId String?      @unique
  status              TenantStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  memberships PrincipalTenantMembership[]

  @@index([status])
}

model PrincipalTenantMembership {
  principalId String
  tenantId    String
  learnerId   String?
  timezone    String                          @default("UTC")
  roles       String[]                        @default([])
  status      PrincipalTenantMembershipStatus @default(ACTIVE)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  principal AuthPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  questions Question[] @relation("QuestionOwnershipMembership")

  @@id([principalId, tenantId])
  @@unique([learnerId])
  @@index([tenantId, status])
  @@index([tenantId, learnerId, status])
}

// =============================================================
// Question Bank - Phase 5.14-E-C
// Normalized Question and Question Version Persistence
// =============================================================

enum QuestionBankType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  NUMERIC
  MATCHING
  ORDERING
  FILL_IN_THE_BLANK
}

enum QuestionBankAnswerFormat {
  SELECTED_OPTION
  SELECTED_OPTIONS
  BOOLEAN
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  MATCHING_PAIRS
  ORDERED_ITEMS
  BLANK_RESPONSES
}

enum QuestionBankFillBlankSegmentKind {
  TEXT
  BLANK
}

enum QuestionBankMatchingMode {
  ONE_TO_ONE
  MANY_TO_ONE
}

model Question {
  id                   String   @id
  tenantId             String?
  createdByPrincipalId String?
  createdAt            DateTime @default(now())

  versions QuestionVersion[]

  ownerMembership PrincipalTenantMembership? @relation("QuestionOwnershipMembership", fields: [createdByPrincipalId, tenantId], references: [principalId, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, id])
}

model QuestionVersion {
  id                    String                    @id
  questionId            String
  versionNumber         BigInt
  questionType          QuestionBankType
  answerFormat          QuestionBankAnswerFormat
  previousVersionId     String?
  restoredFromVersionId String?
  createdAt             DateTime
  completedAt           DateTime?
  question              Question                  @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousVersion       QuestionVersion?          @relation("QuestionVersionPrevious", fields: [previousVersionId, questionId], references: [id, questionId], onDelete: Restrict, onUpdate: Restrict)
  nextVersions          QuestionVersion[]         @relation("QuestionVersionPrevious")
  restoredFrom          QuestionVersion?          @relation("QuestionVersionRestoredFrom", fields: [restoredFromVersionId, questionId], references: [id, questionId], onDelete: Restrict, onUpdate: Restrict)
  restoredIntoVersions  QuestionVersion[]         @relation("QuestionVersionRestoredFrom")
  content               QuestionVersionContent?
  answerKey             QuestionVersionAnswerKey?

  @@unique([questionId, versionNumber])
  @@unique([id, questionId])
  @@index([questionId, createdAt])
  @@index([previousVersionId])
  @@index([restoredFromVersionId])
}

model QuestionVersionContent {
  id                 String                             @id
  questionVersionId  String                             @unique
  questionType       QuestionBankType
  promptText         String?
  numericUnit        String?
  matchingMode       QuestionBankMatchingMode?
  questionVersion    QuestionVersion                    @relation(fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options            QuestionVersionOption[]
  matchingLeftItems  QuestionVersionMatchingLeftItem[]
  matchingRightItems QuestionVersionMatchingRightItem[]
  orderingItems      QuestionVersionOrderingItem[]
  fillBlankSegments  QuestionVersionFillBlankSegment[]

  @@unique([id, questionVersionId])
}

model QuestionVersionOption {
  id                String
  contentId         String
  questionVersionId String
  text              String
  position          Int
  content           QuestionVersionContent        @relation(fields: [contentId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  optionAnswers     QuestionVersionOptionAnswer[]

  @@id([questionVersionId, id])
  @@unique([contentId, position])
  @@index([contentId])
}

model QuestionVersionMatchingLeftItem {
  id                String
  contentId         String
  questionVersionId String
  text              String
  position          Int
  content           QuestionVersionContent        @relation(fields: [contentId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  leftPairs         QuestionVersionMatchingPair[] @relation("MatchingPairLeft")

  @@id([questionVersionId, id])
  @@unique([contentId, position])
}

model QuestionVersionMatchingRightItem {
  id                String
  contentId         String
  questionVersionId String
  text              String
  position          Int
  content           QuestionVersionContent        @relation(fields: [contentId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  rightPairs        QuestionVersionMatchingPair[] @relation("MatchingPairRight")

  @@id([questionVersionId, id])
  @@unique([contentId, position])
}

model QuestionVersionOrderingItem {
  id                String
  contentId         String
  questionVersionId String
  text              String
  position          Int
  content           QuestionVersionContent          @relation(fields: [contentId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  orderingAnswers   QuestionVersionOrderingAnswer[]

  @@id([questionVersionId, id])
  @@unique([contentId, position])
}

model QuestionVersionFillBlankSegment {
  id                String
  contentId         String
  questionVersionId String
  kind              QuestionBankFillBlankSegmentKind
  text              String?
  blankId           String?
  position          Int
  content           QuestionVersionContent           @relation(fields: [contentId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  blankAnswer       QuestionVersionBlankAnswer?

  @@id([questionVersionId, id])
  @@unique([contentId, position])
  @@unique([questionVersionId, blankId])
}

model QuestionVersionAnswerKey {
  id                   String                          @id
  questionVersionId    String                          @unique
  questionType         QuestionBankType
  correctBoolean       Boolean?
  expectedNumericValue Float?
  referenceAnswer      String?
  questionVersion      QuestionVersion                 @relation(fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  optionAnswers        QuestionVersionOptionAnswer[]
  acceptedAnswers      QuestionVersionAcceptedAnswer[]
  matchingPairs        QuestionVersionMatchingPair[]
  orderingAnswers      QuestionVersionOrderingAnswer[]
  blankAnswers         QuestionVersionBlankAnswer[]

  @@unique([id, questionVersionId])
}

model QuestionVersionOptionAnswer {
  answerKeyId       String
  questionVersionId String
  optionId          String
  position          Int
  answerKey         QuestionVersionAnswerKey @relation(fields: [answerKeyId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  option            QuestionVersionOption    @relation(fields: [questionVersionId, optionId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([answerKeyId, optionId])
  @@unique([answerKeyId, position])
}

model QuestionVersionAcceptedAnswer {
  id                String                   @id
  answerKeyId       String
  questionVersionId String
  text              String
  position          Int
  answerKey         QuestionVersionAnswerKey @relation(fields: [answerKeyId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([answerKeyId, position])
  @@index([answerKeyId])
}

/// Each left item must have exactly one correct right-item mapping.
/// The composite primary key prevents duplicate mappings for a left item;
/// the completed-snapshot constraint trigger verifies that every left item
/// has a mapping before the QuestionVersion can be completed.
model QuestionVersionMatchingPair {
  answerKeyId       String
  questionVersionId String
  leftItemId        String
  rightItemId       String
  position          Int
  answerKey         QuestionVersionAnswerKey         @relation(fields: [answerKeyId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  leftItem          QuestionVersionMatchingLeftItem  @relation("MatchingPairLeft", fields: [questionVersionId, leftItemId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  rightItem         QuestionVersionMatchingRightItem @relation("MatchingPairRight", fields: [questionVersionId, rightItemId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([answerKeyId, leftItemId])
  @@unique([answerKeyId, position])
}

model QuestionVersionOrderingAnswer {
  answerKeyId       String
  questionVersionId String
  itemId            String
  position          Int
  answerKey         QuestionVersionAnswerKey    @relation(fields: [answerKeyId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  item              QuestionVersionOrderingItem @relation(fields: [questionVersionId, itemId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([answerKeyId, itemId])
  @@unique([answerKeyId, position])
}

model QuestionVersionBlankAnswer {
  answerKeyId       String
  questionVersionId String
  blankSegmentId    String
  position          Int

  answerKey       QuestionVersionAnswerKey             @relation(fields: [answerKeyId, questionVersionId], references: [id, questionVersionId], onDelete: Restrict, onUpdate: Restrict)
  blankSegment    QuestionVersionFillBlankSegment      @relation(fields: [questionVersionId, blankSegmentId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  acceptedAnswers QuestionVersionBlankAcceptedAnswer[]

  @@id([answerKeyId, blankSegmentId])
  @@unique([answerKeyId, position])
  @@unique([questionVersionId, blankSegmentId])
}

model QuestionVersionBlankAcceptedAnswer {
  id             String                     @id
  answerKeyId    String
  blankSegmentId String
  text           String
  position       Int
  blankAnswer    QuestionVersionBlankAnswer @relation(fields: [answerKeyId, blankSegmentId], references: [answerKeyId, blankSegmentId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([answerKeyId, blankSegmentId, position])
}
