{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@org/api",
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "scope:api",
    "type:application"
  ],
  "targets": {
    "prisma-generate": {
  "executor": "nx:run-commands",
  "options": {
    "command": "pnpm prisma:generate",
    "cwd": "."
  }
},

    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "dependsOn": [
        "prisma-generate"
      ],
      "options": {
        "main": "apps/api/src/main.ts",
        "outputPath": "apps/api/dist",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": []
      }
    },

    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.config.mts",
        "cwd": "apps/api"
      },
      "cache": true
    },

    "runtime-test": {
  "dependsOn": [
    "build"
  ],
  "cache": false,
  "executor": "nx:run-commands",
  "options": {
    "command": "node scripts/run-api-runtime-tests.mjs",
    "cwd": "."
  },
  "configurations": {},
  "parallelism": false
},

    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "options": {
        "buildTarget": "@org/api:build",
        "watch": true,
        "runBuildTargetDependencies": false,
        "runtimeArgs": [
          "--env-file=apps/api/.env"
        ]
      }
    },

    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --build apps/api/tsconfig.app.json --emitDeclarationOnly",
        "cwd": "."
      },
      "cache": true
    }
  }
}