generator client {
  provider = "prisma-client"
  output   = "../../../../../libs/shared/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  RETRYING
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum NotificationAggregationStatus {
  OPEN
  FLUSHING
  FLUSHED
  FAILED
}

/**
 * =============================================================
 * Notification Template Domain
 * =============================================================
 */

enum NotificationTemplateChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationTemplateStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum NotificationTemplateCategory {
  SYSTEM
  SECURITY
  AUTHENTICATION
  COURSE
  LEARNING
  PAYMENT
  SUBSCRIPTION
  CERTIFICATE
  CORPORATE
  MARKETING
  REMINDER
}

model NotificationTemplate {
  id String @id @default(uuid())

  templateId  String  @unique
  name        String
  description String?

  channel  NotificationTemplateChannel
  category NotificationTemplateCategory
  locale   String

  status         NotificationTemplateStatus @default(DRAFT)
  currentVersion Int                        @default(1)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions NotificationTemplateVersion[]

  @@index([channel, status])
  @@index([category, status])
  @@index([locale, status])
  @@index([createdBy, createdAt])
}

model NotificationTemplateVersion {
  id String @id @default(uuid())

  templateId String
  version    Int

  subject String?
  title   String?
  body    String

  variables Json

  status NotificationTemplateStatus @default(DRAFT)

  createdBy   String
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([status, publishedAt])
  @@index([createdBy, createdAt])
}

/**
 * =============================================================
 * Existing Notification Domain
 * =============================================================
 */

model Notification {
  id String @id @default(uuid())

  notificationId String @unique
  userId         String

  channel NotificationChannel
  status  NotificationStatus @default(QUEUED)

  subject String?
  title   String?
  body    String

  template         String?
  templateVersion  Int?
  templateLocale   String?
  templateData     Json?
  templateSnapshot Json?

  provider          String?
  providerMessageId String?

  idempotencyKey String @unique

  attempts Int @default(0)

  queuedAt      DateTime  @default(now())
  processingAt  DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([channel, status])
  @@index([template, templateVersion])
}

model NotificationDelivery {
  id String @id @default(uuid())

  notificationId String
  deliveryKey    String @unique

  provider String
  channel  NotificationChannel

  status NotificationDeliveryStatus @default(PENDING)

  attempts Int @default(0)

  providerMessageId String?

  lastAttemptAt DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([notificationId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status])
}

model OutboxEvent {
  id String @id @default(uuid())

  eventType     String
  aggregateType String
  aggregateId   String

  dedupeKey String @unique

  payload Json

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  availableAt DateTime @default(now())

  lockedAt DateTime?
  lockedBy String?

  publishedAt DateTime?

  deadLetteredAt DateTime?
  recoveredAt    DateTime?

  recoveryCount Int @default(0)

  lastAttemptAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([lockedAt])
  @@index([deadLetteredAt])
}

/**
 * =============================================================
 * Notification Aggregation Domain
 * =============================================================
 */

model NotificationAggregation {
  id String @id @default(uuid())

  aggregationId String @unique

  /**
   * Canonical deterministic identity generated by the
   * aggregation domain policy.
   */
  groupKey String @unique

  userId         String
  channel        NotificationChannel
  category       String
  aggregationKey String
  locale         String

  status NotificationAggregationStatus @default(OPEN)

  windowStart DateTime
  windowEnd   DateTime

  itemCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NotificationAggregationItem[]

  @@index([userId, channel, status])
  @@index([status, windowEnd])
}

model NotificationAggregationItem {
  id String @id @default(uuid())

  aggregationId String

  sourceEventId String
  occurredAt    DateTime
  orderingKey   String

  createdAt DateTime @default(now())

  /*
   * Keep the relation declaration on one line.
   * This avoids the Prisma parser failure currently
   * preventing Prisma Client generation.
   */
  aggregation NotificationAggregation @relation(fields: [aggregationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /*
   * Database-level idempotency:
   * one source event can occur only once in an aggregation.
   */
  @@unique([aggregationId, sourceEventId])

  /*
   * Deterministic retrieval order.
   */
  @@index([aggregationId, orderingKey])
}