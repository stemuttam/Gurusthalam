{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@org/api",
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "scope:api",
    "type:application"
  ],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma generate --config prisma.config.ts",
        "cwd": "apps/api"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "dependsOn": [
        "prisma-generate"
      ],
      "options": {
        "main": "apps/api/src/main.ts",
        "outputPath": "apps/api/dist",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "options": {
        "buildTarget": "@org/api:build",
        "watch": true,
        "runBuildTargetDependencies": false,
        "runtimeArgs": [
          "--env-file=apps/api/.env"
        ]
      }
    }
  }
}