{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "out-tsc", "eslint.config.mjs"],
  "references": [
    {
      "path": "../../libs/shared/logger/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/database/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/config/tsconfig.lib.json"
    }
  ]
}
